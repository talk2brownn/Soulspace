# Copy this file to ".env" (same folder) and fill in your Supabase project's values.
# Supabase dashboard -> Project Settings -> API.
# Leave these empty to run SoulSpace in device-only mode (localStorage).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Never put the service_role / secret key here: anything in this file ends up in the browser.
